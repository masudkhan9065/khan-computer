<div id="jobs" class="section on"><h3>🔧 নতুন সার্ভিস জব</h3><input id="jSearchCust" placeholder="🔍 কাস্টমার খুঁজুন - নাম / মোবাইল" class="inp" oninput="filterJobCust()"><select id="jCust" class="inp"></select><div id="jCustInfo" class="small"></div><select id="jDevice" class="inp"><option>📱 মোবাইল</option><option>💻 ল্যাপটপ</option><option>🖥️ ডেস্কটপ / PC</option><option>🖨️ প্রিন্টার</option><option>⌚ স্মার্ট ওয়াচ</option><option>📷 অন্যান্য</option></select><input id="jModel" placeholder="মডেল - যেমন: Samsung A54 / HP ProBook" class="inp"><input id="jProblem" placeholder="সমস্যা কি? - ডিসপ্লে / ব্যাটারি / সফটওয়্যার / চার্জিং..." class="inp"><input id="jPass" placeholder="প্যাটার্ন / পাসওয়ার্ড (যদি থাকে)" class="inp"><div style="display:flex;gap:6px"><input id="jTotal" type="number" placeholder="মোট বিল ৳" class="inp"><input id="jAdv" type="number" placeholder="অ্যাডভান্স ৳" class="inp"></div><input id="jDate" type="date" class="inp"><select id="jStatus" class="inp"><option>জমা</option><option>কাজ চলছে</option><option>রেডি</option><option>ডেলিভারি</option></select><button class="btn btnP" onclick="addJob()">+ জব যোগ করুন</button><div class="flt"><button class="fltBtn on" onclick="setJobFilter('all',this)">সব</button><button onclick="setJobFilter('জমা',this)">জমা</button><button onclick="setJobFilter('কাজ চলছে',this)">কাজ চলছে</button><button onclick="setJobFilter('রেডি',this)">রেডি</button><button onclick="setJobFilter('ডেলিভারি',this)">ডেলিভারি</button></div><input id="jobSearch" placeholder="🔍 জব খুঁজুন - নাম / মডেল / সমস্যা" class="inp" oninput="render()"><div id="jobList"></div></div>

