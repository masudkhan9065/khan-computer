<script>
var PASS="1234";var ROLE=localStorage.getItem("KHAN_ROLE")||"";
var D=JSON.parse(localStorage.getItem("KHAN_V2")||"null");if(!D)D={customers:[],jobs:[],acc:[]};
var jobFilter="all";
function TS(){var d=new Date();return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0")}
function fmt(n){return "৳"+Number(n||0).toLocaleString()}
function save(){localStorage.setItem("KHAN_V2",JSON.stringify(D))}
function doLogin(){var p=document.getElementById("loginPass").value;if(p===PASS){localStorage.setItem("KHAN_ROLE","admin");document.getElementById("login").style.display="none";initDates();render();renderReport()}else{document.getElementById("loginMsg").innerText="ভুল পাসওয়ার্ড! (ডেমো: 1234)"}}
function logout(){localStorage.removeItem("KHAN_ROLE");document.getElementById("login").style.display="flex"}
if(ROLE){document.getElementById("login").style.display="none"}
function initDates(){var t=TS();["jDate","aDate","repDate"].forEach(function(id){var e=document.getElementById(id);if(e&&!e.value)e.value=t});document.getElementById("todayLabel").innerText=t}
function showTab(id,btn){document.querySelectorAll(".section").forEach(function(s){s.classList.remove("on","printShow")});document.getElementById(id).classList.add("on");document.querySelectorAll(".tab").forEach(function(t){t.classList.remove("on")});if(btn)btn.classList.add("on");if(id=='report')renderReport()}
function openPrint(h){document.getElementById("printBody").innerHTML=h;document.querySelectorAll(".section").forEach(function(s){s.classList.remove("on")});document.getElementById("printArea").classList.add("on","printShow")}
function setJobFilter(f,btn){jobFilter=f;document.querySelectorAll(".flt button").forEach(function(b){b.classList.remove("on")});if(btn)btn.classList.add("on");render()}
function addCustomer(){var n=document.getElementById("cName").value.trim(),m=document.getElementById("cMob").value.trim(),a=document.getElementById("cAddr").value.trim();if(!n||!m)return alert("নাম ও মোবাইল দিন");var id=D.customers.length?Math.max.apply(null,D.customers.map(function(x){return x.id}))+1:1;D.customers.push({id:id,name:n,mob:m,addr:a});save();render();["cName","cMob","cAddr"].forEach(function(x){document.getElementById(x).value=""})}
function filterJobCust(){var q=(document.getElementById("jSearchCust").value||"").toLowerCase();var f=D.customers.filter(function(c){return (c.name+" "+c.mob).toLowerCase().includes(q)});document.getElementById("jCust").innerHTML=f.map(function(c){return '<option value="'+c.id+'">'+c.id+'. '+c.name+' - '+c.mob+'</option>'}).join("")||'<option value="">কাস্টমার নাই - আগে কাস্টমার যোগ করুন</option>';updateJobInfo()}
function updateJobInfo(){var id=parseInt(document.getElementById("jCust").value);var c=D.customers.find(function(x){return x.id==id});document.getElementById("jCustInfo").innerHTML=c?'✅ <b>'+c.name+'</b> | '+c.mob+' | '+c.addr:''}
document.addEventListener("change",function(e){if(e.target.id=="jCust")updateJobInfo()});
function addJob(){var cid=parseInt(document.getElementById("jCust").value);var c=D.customers.find(function(x){return x.id==cid});if(!c)return alert("কাস্টমার বাছুন");var dev=document.getElementById("jDevice").value,model=document.getElementById("jModel").value.trim(),prob=document.getElementById("jProblem").value.trim(),pass=document.getElementById("jPass").value.trim(),tot=parseInt(document.getElementById("jTotal").value||0),adv=parseInt(document.getElementById("jAdv").value||0),date=document.getElementById("jDate").value,st=document.getElementById("jStatus").value;if(!model||!prob)return alert("মডেল ও সমস্যা লিখুন");D.jobs.push({id:Date.now(),cid:cid,name:c.name,mob:c.mob,addr:c.addr,device:dev,model:model,problem:prob,pass:pass,total:tot,adv:adv,due:tot-adv,date:date,status:st});save();render();renderReport();["jModel","jProblem","jPass","jTotal","jAdv"].forEach(function(x){document.getElementById(x).value=""});alert("✅ জব যোগ হইছে - "+c.name+" | বাকি "+fmt(tot-adv))}
function payDueJob(id){var j=D.jobs.find(function(x){return x.id==id});var amt=parseInt(prompt(j.name+" কত টাকা দিলো? বাকি "+j.due,j.due));if(!amt)return;j.adv+=amt;j.due=j.total-j.adv;if(j.due<=0){j.due=0;j.status="ডেলিভারি"}save();render();renderReport()}
function changeStatus(id){var j=D.jobs.find(function(x){return x.id==id});var ns=prompt("স্ট্যাটাস বদলান:\nজমা / কাজ চলছে / রেডি / ডেলিভারি / বাতিল",j.status);if(ns==null)return;j.status=ns;save();render();renderReport()}
function editJob(id){var j=D.jobs.find(function(x){return x.id==id});var t=parseInt(prompt("মোট বিল:",j.total));if(t==null||isNaN(t))return;var a=parseInt(prompt("অ্যাডভান্স:",j.adv));if(a==null||isNaN(a))return;j.total=t;j.adv=a;j.due=Math.max(0,t-a);save();render();renderReport()}
function delJob(id){if(!confirm("ডিলিট করবেন?"))return;D.jobs=D.jobs.filter(function(x){return x.id!=id});save();render();renderReport()}
function delCust(id){if(!confirm("কাস্টমার ডিলিট?"))return;D.customers=D.customers.filter(function(x){return x.id!=id});save();render()}
function addAcc(){var d=document.getElementById("aDate").value,desc=document.getElementById("aDesc").value,amt=parseInt(document.getElementById("aAmt").value),tp=document.getElementById("aType").value;if(!desc||!amt)return alert("বিবরণ ও টাকা দিন");D.acc.push({id:Date.now(),date:d,desc:desc,amt:amt,type:tp});save();render();renderReport();document.getElementById("aDesc").value="";document.getElementById("aAmt").value=""}
function delAcc(id){D.acc=D.acc.filter(function(x){return x.id!=id});save();render();renderReport()}
function render(){var q=(document.getElementById("cSearch").value||"").toLowerCase();var ch="";D.customers.filter(function(c){return (c.name+c.mob+c.addr).toLowerCase().includes(q)}).forEach(function(c){ch+='<div class="list"><b>'+c.id+'. '+c.name+'</b><br><span class="small">📞 '+c.mob+' | '+c.addr+'</span><br><div class="act"><a class="callBtn" href="tel:'+c.mob+'">📞 কল</a><button style="background:#DC2626" onclick="delCust('+c.id+')">ডিলিট</button></div></div>'});document.getElementById("custList").innerHTML=ch||"<p class='small'>কাস্টমার নাই</p>";filterJobCust();var jq=(document.getElementById("jobSearch").value||"").toLowerCase();var jh="";D.jobs.filter(function(j){var ok=jobFilter=="all"||j.status==jobFilter;return ok&&(j.name+j.mob+j.model+j.problem).toLowerCase().includes(jq)}).slice().reverse().forEach(function(j){var cls=j.status.replace(" ","_");jh+='<div class="list"><div style="display:flex;justify-content:space-between"><b>#'+j.id.toString().slice(-4)+' • '+j.name+'</b><span class="badge st-'+cls+'">'+j.status+'</span></div><span class="small">📞 '+j.mob+' | 📅 '+j.date+'</span><br><b>'+j.device+' - '+j.model+'</b><br>🛠️ '+j.problem+(j.pass?' | 🔑 '+j.pass:'')+'<br>💰 মোট: <b>'+fmt(j.total)+'</b> | অ্যাডভান্স: '+fmt(j.adv)+' | <span style="color:#F87171;font-weight:800">বাকি: '+fmt(j.due)+'</span><div class="act"><a class="callBtn" href="tel:'+j.mob+'">📞 কল</a><button style="background:#059669" onclick="payDueJob('+j.id+')">💵 টাকা জমা</button><button style="background:#2563EB" onclick="changeStatus('+j.id+')">🔄 স্ট্যাটাস</button><button style="background:#F59E0B;color:#000" onclick="editJob('+j.id+')">ঠিক</button><button style="background:#7C3AED" onclick="printInvoice('+j.id+')">🧾 বিল</button><button style="background:#DC2626" onclick="delJob('+j.id+')">X</button></div></div>'});document.getElementById("jobList").innerHTML=jh||"<p class='small'>এই স্ট্যাটাসে জব নাই</p>";var dh="";D.jobs.filter(function(j){return j.due>0}).forEach(function(j){dh+='<div class="list"><b>'+j.name+' - '+j.model+'</b> | '+j.mob+'<br>বাকি: <b style="color:#F87171">'+fmt(j.due)+'</b> | স্ট্যাটাস: '+j.status+' <button style="background:#059669;color:#fff;border:none;padding:5px 10px;border-radius:8px" onclick="payDueJob('+j.id+')">টাকা জমা</button></div>'});document.getElementById("dueList").innerHTML=dh||"<p class='small'>✅ বকেয়া নাই</p>";var ah="";D.acc.slice().reverse().forEach(function(a){ah+='<div class="list">'+a.date+' - '+a.desc+' - '+(a.type=='inc'?'+':'-')+' '+fmt(a.amt)+' <button style="background:#DC2626;color:#fff;border:none;padding:3px 8px;border-radius:6px" onclick="delAcc('+a.id+')">X</button></div>'});document.getElementById("accList").innerHTML=ah||"<p class='small'>আয়-ব্যয় নাই</p>";var today=TS();var todayJobs=D.jobs.filter(function(j){return j.date==today});var tInc=todayJobs.reduce(function(a,j){return a+j.adv},0)+D.acc.filter(function(a){return a.date==today&&a.type=='inc'}).reduce(function(a,x){return a+x.amt},0);var tDue=D.jobs.reduce(function(a,j){return a+j.due},0);var pend=D.jobs.filter(function(j){return j.status!='ডেলিভারি'&&j.status!='বাতিল'}).length;var tDel=D.jobs.filter(function(j){return j.date==today&&j.status=='ডেলিভারি'}).length;document.getElementById("todayInc").innerText=fmt(tInc);document.getElementById("totalDue").innerText=fmt(tDue);document.getElementById("pendingJobs").innerText=pend+" টি";document.getElementById("todayDel").innerText=tDel+" টি";document.getElementById("totalCust").innerText=D.customers.length+" জন";document.getElementById("pendingTop").innerText=pend+" টি"}
function renderReport(){var d=document.getElementById("repDate").value||TS();var jobs=D.jobs.filter(function(j){return j.date==d});var inc=jobs.reduce(function(a,j){return a+j.adv},0)+D.acc.filter(function(a){return a.date==d&&a.type=='inc'}).reduce(function(a,x){return a+x.amt},0);var exp=D.acc.filter(function(a){return a.date==d&&a.type=='exp'}).reduce(function(a,x){return a+x.amt},0);document.getElementById("reportBody").innerHTML='<div style="background:#0A0F2A;padding:12px;border-radius:12px;line-height:1.8"><b>📅 '+d+'</b><br>🔧 মোট জব: '+jobs.length+' টি<br>💰 ইনকাম: '+fmt(inc)+'<br>💸 ব্যয়: '+fmt(exp)+'<br><b>লাভ: '+fmt(inc-exp)+'</b><br>🔴 বকেয়া: '+fmt(jobs.reduce(function(a,j){return a+j.due},0))+'</div>'}
function printInvoice(id){var j=D.jobs.find(function(x){return x.id==id});openPrint('<div class="invoice"><h2>💻 KHAN Computer & Stationary</h2><p style="font-size:12px;color:#666">চৌধুরী মার্কেট, তালমা মোড়, ফরিদপুর • 📞 01723339065</p><hr><div class="row"><span>বিল নং: #'+j.id.toString().slice(-4)+'</span><span>তারিখ: '+j.date+'</span></div><div class="row"><span>কাস্টমার: <b>'+j.name+'</b></span><span>📞 '+j.mob+'</span></div><div class="row"><span>ঠিকানা: '+j.addr+'</span></div><div class="row"><span>ডিভাইস: '+j.device+' - '+j.model+'</span></div><div class="row"><span>সমস্যা: '+j.problem+'</span></div><div class="row"><span>স্ট্যাটাস: '+j.status+'</span></div><div class="total"><div class="row"><span>মোট বিল</span><span>'+fmt(j.total)+'</span></div><div class="row"><span>অ্যাডভান্স</span><span>'+fmt(j.adv)+'</span></div><div class="row"><span>বাকি</span><span>'+fmt(j.due)+'</span></div></div><p style="text-align:center;font-size:12px;margin-top:12px">ধন্যবাদ! আবার আসবেন 🙏<br>--- স্বাক্ষর ---</p></div>')}
function printCustomers(){openPrint('<h3 style="text-align:center">কাস্টমার লিস্ট<br><span style="font-size:12px">KHAN Computer & Stationary - তালমা মোড়, ফরিদপুর</span></h3><table><tr><th>ক্রমিক</th><th>নাম</th><th>মোবাইল</th><th>ঠিকানা</th></tr>'+D.customers.map(function(c,i){return '<tr><td>'+(i+1)+'</td><td class="name">'+c.name+'</td><td>'+c.mob+'</td><td>'+c.addr+'</td></tr>'}).join("")+'</table>')}
function printDue(){var l=D.jobs.filter(function(j){return j.due>0});openPrint('<h3 style="text-align:center">বকেয়া লিস্ট</h3><table><tr><th>ক্রমিক</th><th>নাম</th><th>ডিভাইস</th><th>বাকি</th></tr>'+l.map(function(j,i){return '<tr><td>'+(i+1)+'</td><td class="name">'+j.name+'</td><td>'+j.model+'</td><td>'+j.due+'</td></tr>'}).join("")+'</table>')}
function printReport(){var d=document.getElementById("repDate").value||TS();var jobs=D.jobs.filter(function(j){return j.date==d});openPrint('<h3 style="text-align:center">'+d+' রিপোর্ট</h3><table><tr><th>ক্রমিক</th><th>নাম</th><th>ডিভাইস</th><th>মোট</th><th>জমা</th><th>বাকি</th><th>স্ট্যাটাস</th></tr>'+jobs.map(function(j,i){return '<tr><td>'+(i+1)+'</td><td class="name">'+j.name+'</td><td>'+j.model+'</td><td>'+j.total+'</td><td>'+j.adv+'</td><td>'+j.due+'</td><td>'+j.status+'</td></tr>'}).join("")+'</table>')}
initDates();render();renderReport();
</script>
